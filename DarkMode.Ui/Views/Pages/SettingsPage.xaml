<Page x:Class="DarkMode.Ui.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pages="clr-namespace:DarkMode.Ui.ViewModels.Pages"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance pages:SettingsPageViewModel, IsDesignTimeCreatable=False}"
      d:DesignHeight="600" d:DesignWidth="820"
      Background="{DynamicResource MaterialDesignPaper}"
      Foreground="{DynamicResource MaterialDesignBody}"
      FontFamily="{StaticResource AppFontFamily}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,26,28,28">
            <TextBlock Text="设置" FontSize="24" FontWeight="Medium" />
            <TextBlock Text="界面配色跟随系统深浅色，并从当前壁纸取主色（莫奈取色）。" Opacity="0.6" Margin="0,6,0,20" TextWrapping="Wrap" />

            <materialDesign:Card Margin="0,0,0,14" Padding="20" UniformCornerRadius="10">
                <StackPanel>
                    <TextBlock Text="语言" FontSize="15" FontWeight="Medium" />
                    <ComboBox Margin="0,12,0,0" MinWidth="240" HorizontalAlignment="Left"
                              ItemsSource="{Binding SupportedLanguages}"
                              DisplayMemberPath="LanguageName"
                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Padding="20" UniformCornerRadius="10">
                <DockPanel>
                    <ToggleButton DockPanel.Dock="Right"
                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding IsAutoStartEnabled, Mode=TwoWay}" />
                    <StackPanel>
                        <TextBlock Text="开机自启动" FontSize="15" FontWeight="Medium" />
                        <TextBlock Text="登录 Windows 后在后台自动启动（写入当前用户的启动项，不需要管理员权限）"
                                   Opacity="0.6" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</Page>

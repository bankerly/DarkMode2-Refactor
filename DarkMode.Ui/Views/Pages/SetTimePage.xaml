<Page x:Class="DarkMode.Ui.Views.Pages.SetTimePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pages="clr-namespace:DarkMode.Ui.ViewModels.Pages"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance pages:SetTimePageViewModel, IsDesignTimeCreatable=False}"
      d:DesignHeight="600" d:DesignWidth="820"
      Background="{DynamicResource MaterialDesignPaper}"
      Foreground="{DynamicResource MaterialDesignBody}"
      FontFamily="{materialDesign:MaterialDesignFont}"
      TextOptions.TextFormattingMode="Ideal">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,26,28,28">
            <TextBlock Text="时间模式" FontSize="24" FontWeight="Medium" />
            <TextBlock Text="三个模式只能启用一个，选择其中一个会立即关闭另外两个。"
                       Opacity="0.6" Margin="0,6,0,20" TextWrapping="Wrap" />

            <!-- 自定义时间 -->
            <materialDesign:Card Margin="0,0,0,14" Padding="20" UniformCornerRadius="10">
                <StackPanel>
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Right"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsCustomTimeMode, Mode=OneWay}"
                                      IsEnabled="{Binding IsCustomTimeEnabled}"
                                      Click="OnCustomTimeClick" />
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClockOutline" Width="22" Height="22" VerticalAlignment="Center" />
                            <StackPanel Margin="14,0,0,0">
                                <TextBlock Text="自定义时间" FontSize="15" FontWeight="Medium" />
                                <TextBlock Text="每天在固定的时间切换到浅色 / 深色" Opacity="0.6" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0"
                                Visibility="{Binding IsCustomTimeMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <materialDesign:TimePicker SelectedTime="{Binding LightTime, Mode=TwoWay}" Width="150"
                                                  materialDesign:HintAssist.Hint="浅色时间" />
                        <materialDesign:TimePicker SelectedTime="{Binding DarkTime, Mode=TwoWay}" Width="150" Margin="24,0,0,0"
                                                  materialDesign:HintAssist.Hint="深色时间" />
                        <Button Content="保存" Style="{StaticResource MaterialDesignRaisedButton}"
                                Margin="24,0,0,0" VerticalAlignment="Bottom" Command="{Binding SaveTimesCommand}" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- 日出日落 -->
            <materialDesign:Card Margin="0,0,0,14" Padding="20" UniformCornerRadius="10">
                <StackPanel>
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Right"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsSunriseSunsetMode, Mode=OneWay}"
                                      Click="OnSunriseSunsetClick" />
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="WeatherSunsetUp" Width="22" Height="22" VerticalAlignment="Center" />
                            <StackPanel Margin="14,0,0,0">
                                <TextBlock Text="日出日落模式" FontSize="15" FontWeight="Medium" />
                                <TextBlock Text="用 Windows 位置服务获取坐标，按当天的日出 / 日落切换" Opacity="0.6" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <!-- 标签 / 数值 / 操作 各占一行，避免自动列宽把长坐标挤到相邻列上 -->
                    <Grid Margin="0,18,0,0"
                          Visibility="{Binding IsSunriseSunsetMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="经度" Opacity="0.6" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="纬度" Opacity="0.6" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="今天" Opacity="0.6" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LongitudeText}" FontWeight="Medium"
                                   Margin="0,6,24,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LatitudeText}" FontWeight="Medium"
                                   Margin="0,6,24,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SunTimesText}" FontWeight="Medium" Margin="0,6,0,0" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding LocationStatus}" Opacity="0.6"
                                   Margin="0,16,24,0" TextWrapping="Wrap" />
                        <Button Grid.Row="2" Grid.Column="2" Content="重新定位" HorizontalAlignment="Right"
                                Margin="0,16,0,0" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding RelocateCommand}" />
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- 感光模式 -->
            <materialDesign:Card Padding="20" UniformCornerRadius="10">
                <StackPanel>
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Right"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsSensorMode, Mode=OneWay}"
                                      IsEnabled="{Binding IsSensorAvailable}"
                                      Click="OnSensorClick" />
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LightbulbOnOutline" Width="22" Height="22" VerticalAlignment="Center" />
                            <StackPanel Margin="14,0,0,0">
                                <TextBlock Text="感光模式" FontSize="15" FontWeight="Medium" />
                                <TextBlock Text="用设备的环境光传感器自动调整颜色模式" Opacity="0.6" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Margin="0,18,0,0">
                        <TextBlock Text="{Binding AmbientLightText}" FontSize="15" FontWeight="Medium" />
                        <TextBlock Text="{Binding SensorStatusText}" Opacity="0.6" Margin="0,4,0,0" TextWrapping="Wrap" />

                        <TextBlock Text="阈值" Opacity="0.6" Margin="0,16,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                    IsEnabled="{Binding IsSensorAvailable}"
                                    Value="{Binding SensorThreshold, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1" Text="{Binding SensorThreshold, StringFormat={}{0:0} lx}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</Page>

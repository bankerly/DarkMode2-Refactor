<Page x:Class="DarkMode.Ui.Views.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="820"
      Background="{DynamicResource MaterialDesignPaper}"
      Foreground="{DynamicResource MaterialDesignBody}"
      FontFamily="{StaticResource AppFontFamily}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,26,28,28">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/darkmode-icon.ico" Width="44" Height="44" />
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="DarkMode 2" FontSize="24" FontWeight="Medium" />
                    <TextBlock Text="Windows 10/11 自动切换颜色模式工具" Opacity="0.6" />
                </StackPanel>
            </StackPanel>

            <materialDesign:Card Margin="0,20,0,14" Padding="20" UniformCornerRadius="10">
                <StackPanel>
                    <TextBlock Text="工作方式" FontSize="15" FontWeight="Medium" />
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.8"
                               Text="三种模式互斥三选一：自定义时间 / 日出日落 / 感光。切换由后台调度器每秒检查一次，只在状态真正变化时改写系统主题。" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Margin="0,0,0,14" Padding="20" UniformCornerRadius="10">
                <StackPanel>
                    <TextBlock Text="隐私" FontSize="15" FontWeight="Medium" />
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.8"
                               Text="日出日落模式需要读取设备位置以计算当地的日出日落时间，定位通过 Windows 位置服务在本机完成；界面配色由本机读取壁纸主色生成，不上传任何数据。" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Padding="20" UniformCornerRadius="10">
                <StackPanel>
                    <TextBlock Text="关于本项目" FontSize="15" FontWeight="Medium" />
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.8"
                               Text="原项目 DarkMode2 由 Lunova Studio 开发，采用 GPL-3.0 许可。本分支在此基础上重构了启动流程、日出日落模式，并改用 Material Design 界面与壁纸取色。" />
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</Page>

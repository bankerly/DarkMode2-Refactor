<Window x:Class="DarkMode.Ui.Views.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DarkMode 设置中心"
        Height="660" Width="1040"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        SourceInitialized="OnSourceInitialized"
        Background="Transparent"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource AppFontFamily}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 透明底：让窗口背后的亚克力模糊透到导航列 -->
        <Border Grid.Column="0" Background="Transparent">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,26,20,18">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/darkmode-icon.ico" Width="30" Height="30" />
                        <TextBlock Text="DarkMode" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontSize="19" FontWeight="Medium" />
                    </StackPanel>
                    <TextBlock Text="Windows 自动切换颜色模式" Opacity="0.6" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <ListBox x:Name="NavList"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding NavItems}"
                         SelectionChanged="NavList_OnSelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                            <Setter Property="Padding" Value="16,12" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="{Binding Icon}" VerticalAlignment="Center" Width="20" Height="20" />
                                <TextBlock Text="{Binding Title}" Margin="16,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Frame x:Name="PageHost" Grid.Column="1" NavigationUIVisibility="Hidden" Background="Transparent" BorderThickness="0" />
    </Grid>
</Window>

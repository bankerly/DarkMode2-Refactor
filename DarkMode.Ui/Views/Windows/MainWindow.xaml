<Window x:Class="DarkMode.Ui.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
        Title="DarkMode"
        Width="1" Height="1"
        ShowInTaskbar="False"
        WindowStyle="None"
        WindowState="Minimized"
        Visibility="Hidden"
        Opacity="0">
    <Grid>
        <tray:NotifyIcon
            x:Name="TrayIcon"
            FocusOnLeftClick="False"
            MenuOnRightClick="True"
            Icon="pack://application:,,,/Assets/darkmode-icon.ico"
            LeftClick="OnTrayLeftClick"
            LeftDoubleClick="OnTrayLeftClick"
            TooltipText="DarkMode">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <MenuItem Header="设置" Click="OnOpenSettings" />
                    <Separator />
                    <MenuItem Header="退出" Click="OnExit" />
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>
    </Grid>
</Window>
